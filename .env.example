# ===== VitaCare Environment Variables =====
# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่า

# ----- Database -----
DATABASE_URL="file:./dev.db"

# ----- Auth.js (NextAuth) -----
# สร้างด้วย: npx auth secret
AUTH_SECRET=""

# ----- URL -----
AUTH_URL="http://localhost:3000"

# ----- Seed (ใช้ตอน dev เท่านั้น) -----
SEED_ADMIN_EMAIL="admin@vitacare.dev"
SEED_ADMIN_PASSWORD="Admin@1234"
SEED_CUSTOMER_EMAIL="customer@vitacare.dev"
SEED_CUSTOMER_PASSWORD="Customer@1234"